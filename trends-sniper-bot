import time
import requests
import google.generativeai as genai
from datetime import datetime

# 1. إعدادات المفاتيح والروابط (توضع مرة واحدة فقط)
GEMINI_API_KEY = "ضع_هنا_مفتاح_جيميني_المجاني"
WORDPRESS_URL = "https://yourwebsite.com"
WP_USERNAME = "admin_username"
WP_APP_PASSWORD = "xxxx xxxx xxxx xxxx" # كلمة مرور التطبيقات من ووردبريس

# تهيئة محرك ذكاء جوجل الاصطناعي
genai.configure(api_key=GEMINI_API_KEY)
model = genai.GenerativeModel('gemini-pro')

def generate_automated_article(topic):
    """توليد مقال احترافي متوافق مع السيو تلقائياً"""
    prompt = f"""
    Write a comprehensive, professional, and SEO-optimized article about '{topic}'.
    The article must include:
    - An engaging title
    - Catchy subheadings (H2, H3)
    - Detailed informative paragraphs
    - High-traffic keywords related to the topic
    Format the entire output directly in clean HTML tags (e.g., <h2>, <p>).
    Do not include any conversational text or markdown. Jump straight to the article.
    """
    try:
        response = model.generate_content(prompt)
        return response.text
    except Exception as e:
        print(f"خطأ في توليد المحتوى: {e}")
        return None

def publish_to_wordpress(title, content):
    """نشر المقال مباشرة على الموقع بدون تدخل بشري"""
    credentials = (WP_USERNAME, WP_APP_PASSWORD)
    payload = {
        "title": title,
        "content": content,
        "status": "publish", # نشر فوري ومباشر
        "categories": [1]    # رقم القسم الافتراضي في موقعك
    }
    
    try:
        res = requests.post(WORDPRESS_URL, json=payload, auth=credentials)
        if res.status_config == 201 or res.status_code == 200:
            print(f"🎉 تم بنجاح نشر المقال تلقائياً: {title}")
        else:
            print(f"فشل النشر الرقمي. كود الاستجابة: {res.status_code}")
    except Exception as e:
        print(f"خطأ أثناء الاتصال بالموقع: {e}")

# قائمة مؤتمتة متجددة للمواضيع المستهدفة (يمكن ربطها بـ API للأخبار والترندات لاحقاً)
trending_topics = [
    "Artificial Intelligence trends in 2027",
    "Best front-end web development tools",
    "How to automate online businesses with zero budget",
    "Graphic design secrets for high-converting ads"
]

def start_infinite_automation():
    print("==========================================")
    print("🚀 تم إطلاق نظام النشر الذاتي المؤتمت بالكامل...")
    print(f"⏰ وقت البدء: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
    print("==========================================")
    
    index = 0
    while True:
        # اختيار موضوع من القائمة بالترتيب
        current_topic = trending_topics[index % len(trending_topics)]
        print(f"\n[🔍] البدء في معالجة وكتابة موضوع: {current_topic}")
        
        # 1. توليد المقال بالذكاء الاصطناعي
        article_html = generate_automated_article(current_topic)
        
        if article_html:
            # 2. النشر التلقائي على الموقع
            publish_to_wordpress(title=current_topic, content=article_html)
        
        # الانتقال للموضوع التالي
        index += 1
        
        # الانتظار لمدة 8 ساعات (28800 ثانية) قبل كتابة ونشر المقال التالي تلقائياً
        # هذا يضمن بقاء السيرفر نشطاً والنشر المنتظم لرفع ترتيبك في جوجل
        print("💤 البوت في وضع الاستعداد الآن.. سيعود للعمل والنشر تلقائياً بعد 8 ساعات.")
        time.sleep(28800)

if __name__ == "__main__":
    start_infinite_automation()
