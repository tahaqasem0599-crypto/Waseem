def auto_generate_new_topics():
    prompt = "Generate 5 high-CPC, viral blog post titles in English related to AI, passive income, business automation, and finance for 2026. Return only the titles as a plain text list separated by newlines. No numbers, no dots."
    try:
        response = model.generate_content(prompt)
        titles = response.text.strip().split('\n')
        for title in titles:
            if title.strip():
                db_add_topic(title.strip())
    except:
        pass

def generate_seo_article(topic):
    prompt = f"""
    Write a highly professional, viral, and ultimate SEO-optimized blog article in English about: '{topic}'.
    Strict Blueprint:
    1. Hook introduction with a high-level overview.
    2. Organize content with semantic HTML elements (Use <h1>, <h2>, <h3>, <p>, <ul>, <li>).
    3. Include bullet points, bold key terms for scanning, and clean structural paragraphs.
    4. Write an optimized Meta Description wrapped inside an HTML comment at the very top.
    5. No markdown boxes, no ```html code blocks. Output pure clean raw HTML content directly.
    """
    try:
        response = model.generate_content(prompt)
        return response.text
    except:
        return None

def publish_to_wordpress(title, html_content):
    credentials = (WP_USERNAME, WP_APP_PASSWORD)
    payload = {
        "title": title,
        "content": html_content,
        "status": "publish"
    }
    try:
        response = requests.post(WORDPRESS_URL, json=payload, auth=credentials, timeout=25)
        return response.status_code in [200, 201]  # تم إصلاح واستكمال السطر المقطوع هنا بالكامل
    except:
        return False

def background_worker(sleep_time):
    current_index = 0
    while db_get_stat("is_running") == "1":
        topics = db_get_topics()
        
        if len(topics) <= 2 and auto_generate_mode:
            auto_generate_new_topics()
            topics = db_get_topics()
            
        if not topics:
            time.sleep(10)
            continue
            
        topic = topics[current_index % len(topics)]
        db_set_stat("last_topic", topic)
        
        content = generate_seo_article(topic)
        if content:
            success = publish_to_wordpress(topic, content)
            if success:
                current_total = int(db_get_stat("total_published", "0"))
                db_set_stat("total_published", current_total + 1)
                
        current_index += 1
        time.sleep(sleep_time)

