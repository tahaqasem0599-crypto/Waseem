# ==================== 3. المحركات التنفيذية والربط السحابي الذكي ====================
def generate_advanced_seo_article(topic):
    if not SYSTEM_CONFIG["gemini_api_key"]:
        return None
    prompt = f"""
    Write a comprehensive, viral, and deeply informative article in English about the topic: '{topic}'.
    The article must be highly professional, structured for search engines, and engaging for readers.
    Output the entire response directly using clean HTML tags (<h1>, <h2>, <p>, <ul>, <li>).
    """
    try:
        response = model.generate_content(prompt)
        return response.text
    except Exception as e:
        print(f"⚠️ [خطأ في توليد المحتوى]: {e}")
        return None

def publish_automated_post(title, html_content):
    credentials = (SYSTEM_CONFIG["wp_username"], SYSTEM_CONFIG["wp_app_password"])
    payload = {"title": title, "content": html_content, "status": "publish"}
    try:
        response = requests.post(SYSTEM_CONFIG["wordpress_posts_url"], json=payload, auth=credentials)
        if response.status_code in:
            print(f"✅ [نشر ناجح]: تم بنجاح ضخ ونشر المقال تلقائياً: [{title}]")
        else:
            print(f"❌ [فشل في النشر]: كود الحالة: {response.status_code}")
    except Exception as e:
        print(f"⚠️ [خطأ اتصال سحابي]: فشل الاتصال بموقعك: {e}")

