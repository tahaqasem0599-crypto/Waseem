# ==================== 5. المحركات الخلفية المؤتمتة ====================
def generate_seo_article(topic):
    prompt = f"Write a comprehensive, viral, and SEO-optimized article in English about: '{topic}'. Output direct clean HTML content only."
    try:
        response = model.generate_content(prompt)
        return response.text
    except Exception as e:
        st.error(f"خطأ أثناء توليد المحتوى: {e}")
        return None

def publish_to_wordpress(title, html_content):
    credentials = (WP_USERNAME, WP_APP_PASSWORD)
    payload = {"title": title, "content": html_content, "status": "publish"}
    try:
        response = requests.post(WORDPRESS_URL, json=payload, auth=credentials)
        return response.status_code in [200, 201]
    except:
        return False

# زر التحكم لتشغيل الدورة الآلية مباشرة من واجهة Streamlit
st.markdown("---")
