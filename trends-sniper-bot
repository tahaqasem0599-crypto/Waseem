        current_index = 0
        while True:
            topic = trending_topics[current_index % len(trending_topics)]
            st.session_state.last_topic = topic
            
            # 1. توليد المقال بالذكاء الاصطناعي
            content = generate_seo_article(topic)
            if content:
                # 2. النشر الفوري في موقعك الإلكتروني لتبدأ في جني أرباح الإعلانات
                success = publish_to_wordpress(topic, content)
                if success:
                    st.session_state.total_published += 1
                    st.toast(f"✅ تم نشر مقال جديد بنجاح: {topic}")
            
            current_index += 1
            
            # الانتظار التلقائي المنظم لمدة 8 ساعات قبل معالجة المقال التالي لحماية سيو الموقع
            time.sleep(28800)
            st.rerun() # إعادة تنشيط وتحديث أرقام لوحة التحكم تلقائياً
